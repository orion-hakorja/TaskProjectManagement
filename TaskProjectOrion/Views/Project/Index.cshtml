@model IEnumerable<TaskProjectOrion.Models.Project>

@{
    ViewData["Title"] = "Projects";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Projects</h2>
            <p class="text-muted mb-0">Manage and monitor your projects.</p>
        </div>

        <a asp-controller="Project"
           asp-action="Create"
           class="btn btn-primary rounded-3 px-4">
            <i class="fa-solid fa-plus me-2"></i>
            Create Project
        </a>
    </div>
    <form asp-controller="Project"
          asp-action="Search"
          method="get"
          class="mb-4">

        <div class="input-group">
            <input type="text"
                   name="query"
                   class="form-control"
                   placeholder="Search projects by name, description or status..."
                   value="@Context.Request.Query["query"]" />

            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-magnifying-glass me-2"></i>
                Search
            </button>

            <a asp-action="Index" class="btn btn-outline-secondary">
                Clear
            </a>
        </div>
    </form>
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <p class="text-muted mb-2">Total Projects</p>
                    <h3 class="fw-bold mb-0">@Model.Count()</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <p class="text-muted mb-2">Initialized Projects</p>
                    <h3 class="fw-bold mb-0">
                        @Model.Count(p => p.status == "Initialized")
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <p class="text-muted mb-2">Other Statuses</p>
                    <h3 class="fw-bold mb-0">
                        @Model.Count(p => p.status != "Initialized")
                    </h3>
                </div>
            </div>
        </div>

    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table align-middle">

                        <thead>
                            <tr class="text-muted">
                                <th>Project Name</th>
                                <th>Description</th>
                                <th>Tasks</th>
                                <th>Start Date</th>
                                <th>Deadline</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var project in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        @project.Name
                                    </td>

                                    <td>
                                        @project.Description
                                    </td>

                                    <td>
                                        <a asp-controller="Project"
                                           asp-action="Details"
                                           asp-route-id="@project.Id"
                                           class="btn btn-sm btn-primary">
                                            <i class="fa-solid fa-eye me-1"></i>
                                            Details
                                        </a>
                                    </td>   

                                    <td>
                                        @project.StartDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        @(project.deadline?.ToString("dd MMM yyyy") ?? "No deadline set")
                                    </td>

                                    <td>
                                        <span class="badge bg-primary-subtle text-primary">
                                            @project.status
                                        </span>
                                    </td>

                                    <td class="text-end">
                                        <div class="d-flex justify-content-end gap-2">

                                            <a asp-controller="Project"
                                               asp-action="Edit"
                                               asp-route-id="@project.Id"
                                               class="btn btn-sm btn-outline-primary rounded-3">
                                                <i class="fa-solid fa-pen-to-square me-1"></i>
                                                Edit
                                            </a>

                                            <form asp-controller="Project"
                                                  asp-action="Delete"
                                                  asp-route-id="@project.Id"
                                                  method="post"
                                                  onsubmit="return confirm('Are you sure you want to delete this project?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger rounded-3">
                                                    <i class="fa-solid fa-trash me-1"></i>
                                                    Delete
                                                </button>

                                            </form>

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fa-solid fa-folder-open fa-3x text-muted mb-3"></i>

                    <h5>No projects yet</h5>

                    <p class="text-muted">
                        Create your first project to get started.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-primary rounded-3">
                        Create Project
                    </a>
                </div>
            }

        </div>
    </div>

</div>