@model TaskProjectOrion.Models.Project

@{
    ViewData["Title"] = "Create Project";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="mb-4">
                <a asp-action="Index" class="text-decoration-none text-muted">
                    <i class="fa-solid fa-arrow-left me-2"></i>
                    Back to Projects
                </a>

                <h2 class="fw-bold mt-3">Create New Project</h2>
                <p class="text-muted">
                    Enter the details below to create a new project.
                </p>
            </div>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">

                    <form asp-controller="Project"
                          asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-4">
                            <label asp-for="Name" class="form-label fw-semibold">
                                Project Name
                            </label>

                            <input asp-for="Name"
                                   class="form-control form-control-lg"
                                   placeholder="Enter project name" />

                            <span asp-validation-for="Name"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description"
                                   class="form-label fw-semibold">
                                Description
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="5"
                                      placeholder="Describe your project..."></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="deadline"
                                   class="form-label fw-semibold">
                                Project Deadline
                            </label>

                            <input asp-for="deadline"
                                   type="date"
                                   class="form-control form-control-lg" />

                            <span asp-validation-for="deadline"
                                  class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index"
                               class="btn btn-light border rounded-3 px-4">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-primary rounded-3 px-4">
                                <i class="fa-solid fa-plus me-2"></i>
                                Create Project
                            </button>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>