@model IEnumerable<TaskProjectOrion.Models.Task>

@{
    ViewData["Title"] = "Project Details";

    var tasks = Model?.ToList() ?? new List<TaskProjectOrion.Models.Task>();

    var totalTasks = tasks.Count;
    var completedTasks = tasks.Count(t => t.status == "Completed");
    var inProgressTasks = tasks.Count(t => t.status == "In Progress");
    var todoTasks = tasks.Count(t => t.status == "To Do");

    var projectName = ViewBag.ProjectName ?? "Project Details";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;600;700&display=swap" rel="stylesheet">

<style>
    body {
        font-family: 'Inter', sans-serif;
        background: #f8fafc;
    }

    .details-container {
        max-width: 1250px;
        margin: 40px auto;
        padding: 0 20px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        gap: 15px;
    }

    .page-header h2 {
        font-size: 27px;
        font-weight: 700;
        color: #111827;
        margin-bottom: 7px;
    }

    .page-header p {
        color: #64748b;
        font-size: 14px;
        margin: 0;
    }

    .btn-custom {
        padding: 11px 18px;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border: none;
    }

    .btn-back {
        background: #eef2ff;
        color: #4f46e5;
    }

    .btn-create {
        background: #4f46e5;
        color: white;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
        margin-bottom: 28px;
    }

    .stat-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 13px;
        padding: 22px;
        box-shadow: 0 3px 12px rgba(0,0,0,0.025);
    }

    .stat-label {
        color: #64748b;
        font-size: 13px;
        font-weight: 500;
    }

    .stat-number {
        font-size: 28px;
        font-weight: 700;
        color: #111827;
        margin-top: 9px;
    }

    .table-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        padding: 25px;
        box-shadow: 0 3px 12px rgba(0,0,0,0.025);
    }

    .table-title {
        font-size: 17px;
        font-weight: 700;
        color: #111827;
        margin-bottom: 20px;
    }

    .table {
        margin-bottom: 0;
    }

    .table thead th {
        color: #64748b;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        padding: 15px 12px;
        border-bottom: 1px solid #e5e7eb;
        white-space: nowrap;
    }

    .table tbody td {
        padding: 17px 12px;
        font-size: 13px;
        color: #374151;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: middle;
    }

    .task-title {
        font-weight: 600;
        color: #111827;
    }

    .user-badge {
        display: inline-block;
        background: #f1f5f9;
        color: #334155;
        border: 1px solid #e2e8f0;
        padding: 5px 9px;
        border-radius: 6px;
        font-size: 11px;
        margin: 2px;
    }

    .status-badge, .priority-badge {
        display: inline-block;
        padding: 6px 10px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 600;
        white-space: nowrap;
    }

    .status-completed {
        background: #dcfce7;
        color: #15803d;
    }

    .status-progress {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .status-todo {
        background: #f1f5f9;
        color: #475569;
    }

    .priority-low {
        background: #f1f5f9;
        color: #475569;
    }

    .priority-medium {
        background: #fef3c7;
        color: #92400e;
    }

    .priority-high {
        background: #ffedd5;
        color: #c2410c;
    }

    .priority-critical {
        background: #fee2e2;
        color: #b91c1c;
    }

    .empty-state {
        text-align: center;
        padding: 65px 20px;
    }

    .empty-state i {
        font-size: 42px;
        color: #cbd5e1;
        margin-bottom: 18px;
    }

    .empty-state h5 {
        color: #111827;
        font-weight: 700;
    }

    .empty-state p {
        color: #64748b;
        font-size: 13px;
    }

    @@media (max-width: 768px) {
        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .table-card {
            padding: 15px;
        }
    }
</style>

<div class="details-container">

    <!-- Header -->
    <div class="page-header">
        <div>
            <h2>@projectName</h2>
            <p>Project overview and assigned tasks.</p>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn-custom btn-back">
                <i class="fa-solid fa-arrow-left"></i>
                Back to Projects
            </a>

            <a asp-controller="Task"
               asp-action="Create"
               class="btn-custom btn-create">
                <i class="fa-solid fa-plus"></i>
                Create Task
            </a>
        </div>
    </div>

    <!-- Statistics -->
    <div class="stats-grid">

        <div class="stat-card">
            <div class="stat-label">Total Tasks</div>
            <div class="stat-number">@totalTasks</div>
        </div>

        <div class="stat-card">
            <div class="stat-label">Completed</div>
            <div class="stat-number">@completedTasks</div>
        </div>

        <div class="stat-card">
            <div class="stat-label">In Progress</div>
            <div class="stat-number">@inProgressTasks</div>
        </div>

        <div class="stat-card">
            <div class="stat-label">To Do</div>
            <div class="stat-number">@todoTasks</div>
        </div>

    </div>

    <!-- Tasks -->
    <div class="table-card">

        <h5 class="table-title">
            <i class="fa-solid fa-list-check me-2 text-primary"></i>
            Project Tasks
        </h5>

        @if (tasks.Any())
        {
            <div class="table-responsive">

                <table class="table align-middle">

                    <thead>
                        <tr>
                            <th>Task ID</th>
                            <th>Title</th>
                            <th>Description</th>
                            <th>Assigned Users</th>
                            <th>Status</th>
                            <th>Priority</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var task in tasks)
                        {
                            <tr>
                                <td>#@task.Id</td>

                                <td>
                                    <span class="task-title">
                                        @task.Title
                                    </span>
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(task.Description)
                                        ? "No description"
                                        : task.Description)
                                </td>

                                <td>
                                    @if (task.Users != null && task.Users.Any())
                                    {
                                        foreach (var user in task.Users)
                                        {
                                            <span class="user-badge">
                                                @(user.FullName ?? user.UserName)
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            No users assigned
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (task.status == "Completed")
                                    {
                                        <span class="status-badge status-completed">
                                            Completed
                                        </span>
                                    }
                                    else if (task.status == "In Progress")
                                    {
                                        <span class="status-badge status-progress">
                                            In Progress
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-todo">
                                            @task.status
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (task.priority == "Critical")
                                    {
                                        <span class="priority-badge priority-critical">
                                            Critical
                                        </span>
                                    }
                                    else if (task.priority == "High")
                                    {
                                        <span class="priority-badge priority-high">
                                            High
                                        </span>
                                    }
                                    else if (task.priority == "Medium")
                                    {
                                        <span class="priority-badge priority-medium">
                                            Medium
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="priority-badge priority-low">
                                            @task.priority
                                        </span>
                                    }
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="fa-solid fa-folder-open"></i>

                <h5>No tasks in this project</h5>

                <p>
                    This project doesn't have any tasks yet.
                    Create your first task to get started.
                </p>

                <a asp-controller="Task"
                   asp-action="Create"
                   class="btn-custom btn-create mt-2">
                    <i class="fa-solid fa-plus"></i>
                    Create First Task
                </a>
            </div>
        }

    </div>

</div>
