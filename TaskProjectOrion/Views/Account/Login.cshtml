 @model TaskProjectOrion.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login | TaskProjectOrion</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f3f4f8;
            padding: 20px;
            color: #111827;
        }

        .login-container {
            width: 100%;
            max-width: 440px;
            background: white;
            padding: 42px;
            border-radius: 20px;
            box-shadow: 0 15px 45px rgba(15, 23, 42, 0.08);
        }

        .logo {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 11px;
            margin-bottom: 35px;
        }

        .logo-icon {
            width: 43px;
            height: 43px;
            background: #4f46e5;
            color: white;
            border-radius: 12px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 19px;
        }

        .logo h2 {
            font-size: 21px;
            font-weight: 800;
            letter-spacing: -0.7px;
        }

        .heading {
            text-align: center;
            margin-bottom: 30px;
        }

        .heading h1 {
            font-size: 27px;
            font-weight: 800;
            letter-spacing: -1px;
            margin-bottom: 9px;
        }

        .heading p {
            font-size: 13px;
            color: #6b7280;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 9px;
        }

        .input-wrapper {
            position: relative;
        }

        .input-wrapper i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #9ca3af;
            font-size: 14px;
        }

        .input-wrapper input {
            width: 100%;
            height: 49px;
            padding: 0 15px 0 43px;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            outline: none;
            font-family: inherit;
            font-size: 13px;
            transition: 0.2s;
        }

        .input-wrapper input:focus {
            border-color: #4f46e5;
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.10);
        }

        .validation {
            display: block;
            color: #dc2626;
            font-size: 12px;
            margin-top: 6px;
        }

        .validation-summary {
            color: #dc2626;
            font-size: 12px;
            margin-bottom: 15px;
        }

        .login-btn {
            width: 100%;
            height: 49px;
            border: none;
            border-radius: 10px;
            background: #4f46e5;
            color: white;
            font-family: inherit;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            transition: 0.2s;
            margin-top: 7px;
        }

        .login-btn:hover {
            background: #4338ca;
            transform: translateY(-1px);
        }

        .register-link {
            text-align: center;
            margin-top: 25px;
            font-size: 13px;
            color: #6b7280;
        }

        .register-link a {
            color: #4f46e5;
            font-weight: 700;
            text-decoration: none;
        }

        .register-link a:hover {
            text-decoration: underline;
        }

        @@media (max-width: 480px) {
            .login-container {
                padding: 30px 23px;
            }
        }
    </style>
</head>

<body>

    <div class="login-container">

        <div class="logo">
            <div class="logo-icon">
                <i class="fa-solid fa-layer-group"></i>
            </div>
            <h2>TaskProjectOrion</h2>
        </div>

        <div class="heading">
            <h1>Welcome back</h1>
            <p>Sign in to continue to your workspace.</p>
        </div>

        <form asp-controller="Account" asp-action="Login" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="All" class="validation-summary"></div>

            <div class="form-group">
                <label asp-for="Email">Email address</label>

                <div class="input-wrapper">
                    <i class="fa-regular fa-envelope"></i>
                    <input asp-for="Email" type="email" placeholder="Enter your email" />
                </div>

                <span asp-validation-for="Email" class="validation"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password">Password</label>

                <div class="input-wrapper">
                    <i class="fa-solid fa-lock"></i>
                    <input asp-for="Password" type="password" placeholder="Enter your password" />
                </div>

                <span asp-validation-for="Password" class="validation"></span>
            </div>

            <button type="submit" class="login-btn">
                Sign In <i class="fa-solid fa-arrow-right"></i>
            </button>

        </form>

        <div class="register-link">
            Don't have an account?
            <a asp-controller="Account" asp-action="Register">Create account</a>
        </div>

    </div>

</body>
</html>